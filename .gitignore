# ==========================================
# ۱. محیط مجازی پایتون (Virtual Environments)
# ==========================================
venv/
env/
.venv/
ENV/

# ==========================================
# ۲. فایل‌های کش و کامپایل شده پایتون
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# ۳. داده‌های خصوصی پروژه و دیتابیس‌ها (بسیار مهم)
# ==========================================
# جلوگیری از آپلود تاریخچه چت‌ها، اسناد شخصی و دیتابیس برداری
data/*.db
data/*.sqlite3
data/documents/*
data/vector_store/*

# حفظ ساختار پوشه data در گیت با نگه داشتن فایل‌های خالی
!data/documents/.gitkeep
!data/vector_store/.gitkeep

# ==========================================
# ۴. تنظیمات حساس و کلیدهای API
# ==========================================
.env
.env.local
# اگر کلید OpenRouter یا GitHub را در settings.json ذخیره می‌کنید، این خط را فعال نگه دارید:
config/settings.json

# ==========================================
# ۵. فایل‌های ویرایشگر کد و سیستم‌عامل
# ==========================================
.vscode/
local-ai-assistant.code-workspace
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db




